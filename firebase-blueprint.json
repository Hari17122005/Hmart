{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information synchronized from Firebase Auth.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase UID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "User email" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "profileImage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "unit": { "type": "string" },
        "inStock": { "type": "boolean" },
        "rating": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product collection"
    }
  }
}
